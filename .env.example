# ===================================================
#  Application Configuration
# ===================================================

# APP_NAME: Application name which will be used for prefixes, notifications,
# titles and any other places where the app name is required
# Example: codecannon
APP_NAME=<NAMESPACE>

# HTTP_PROTOCOL: Application protocol which will be used for generating links
# with all of the other urls.
# Possible values: http, https
HTTP_PROTOCOL=http

# APP_URL: Application URL (both frontend and backend).
# URL should be without trailing slash, and wihtout http/https prefix.
# Example: localhost
APP_URL=localhost

# APP_URL: Application port (both frontend and backend).
# Should be a valid port number.
# Example: 80
APP_PORT=9999

# ===================================================
#  Mail Configuration
# ===================================================

# For local development, the default configuration uses MailHog
# To see emails, access the MailHog web interface at http://localhost:8025

# MAIL_USERNAME: Mail server username (if necessary)
# Not needed for MailHog
MAIL_USERNAME=null

# MAIL_PASSWORD: Mail server password (if necessary)
# Not needed for MailHog
MAIL_PASSWORD=null

# ===================================================
#  Docker Configuration
# ===================================================

# HOST_UID: Host user ID for container user mapping
# The user ID (UID) of your host system user. When set, containers will create
# a user with this UID so that files created inside containers are owned by
# your host user. This prevents permission issues with volume mounts.
# Example: 1000
HOST_UID=1000

# HOST_GID: Host group ID for container user mapping
# The group ID (GID) of your host system user. When set, containers will create
# a group with this GID so that files created inside containers are owned by
# your host group. This prevents permission issues with volume mounts.
# Example: 1000
HOST_GID=1000
